{
  "info": {
    "name": "COMP3123 Week 06 Notes",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "noteId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Create a note",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/notes",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"content\": {\n    \"noteTitle\": \"Sample Note Title\",\n    \"noteDescription\": \"Sample Note Description\",\n    \"priority\": \"HIGH\",\n    \"dateAdded\": \"06/Oct/2025\",\n    \"dateUpdated\": \"06/Oct/2025\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"noteId\", pm.response.json()._id);"
            ]
          }
        }
      ]
    },
    {
      "name": "List notes",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/notes"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Read one note",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/notes/{{noteId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Update the note",
      "request": {
        "method": "PUT",
        "url": "{{baseUrl}}/notes/{{noteId}}",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"content\": {\n    \"noteTitle\": \"Updated Note Title\",\n    \"noteDescription\": \"Updated Note Description\",\n    \"priority\": \"MEDIUM\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Delete the note",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/notes/{{noteId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Confirm deletion",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/notes/{{noteId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    }
  ]
}
